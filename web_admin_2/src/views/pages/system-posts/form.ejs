<%
  const values = formValues || {};
  const provinces = formData.provinces || [];
  const statuses = formData.statuses || [];
  const isEdit = mode === 'edit';
%>

<section class="system-post-editor">
  <header class="system-post-editor__topbar">
    <div class="system-post-editor__heading">
      <a href="/admin/system-posts" aria-label="Quay lại danh sách">←</a>
      <div><span>Trung tâm nội dung</span><h2><%= isEdit ? 'Chỉnh sửa bài viết' : 'Tạo bài viết mới' %></h2></div>
    </div>
    <div class="system-post-editor__top-actions">
      <span class="system-post-editor__save-state" id="system-post-save-state">Chưa có thay đổi</span>
      <% if (isEdit && values.id) { %><a class="secondary-button" href="/admin/system-posts/<%= values.id %>">Xem bài viết</a><% } %>
      <button class="primary-button" type="submit" form="system-post-form" id="system-post-submit-button">Lưu bài viết</button>
    </div>
  </header>

  <% if (successMessage) { %><p data-notification="success"><%= successMessage %></p><% } %>
  <% if (errorMessage) { %><p class="form-error" data-notification="error"><%= errorMessage %></p><% } %>

  <form id="system-post-form" method="post" action="<%= submitAction %>" class="system-post-editor__layout">
    <main class="system-post-editor__main">
      <section class="system-post-editor-card system-post-editor-card--content">
        <div class="system-post-editor-card__head">
          <div><span class="system-posts-eyebrow">Nội dung bài viết</span><h3>Thông tin biên tập</h3></div>
          <div class="system-post-language-tabs" role="tablist" aria-label="Ngôn ngữ">
            <button type="button" class="is-active" role="tab" aria-selected="true" data-editor-language="vi">Tiếng Việt <i></i></button>
            <button type="button" role="tab" aria-selected="false" data-editor-language="en">English <i></i></button>
          </div>
        </div>

        <div class="system-post-language-panel" data-language-panel="vi">
          <label class="system-post-field"><span>Tiêu đề bài viết <b>*</b></span><input type="text" id="system-post-title-vi" name="titleVi" value="<%= values.titleVi || '' %>" placeholder="Nhập tiêu đề rõ ràng, hấp dẫn" required /></label>
          <label class="system-post-field"><span>Danh mục</span><input type="text" name="categoryVi" value="<%= values.categoryVi || '' %>" placeholder="Ví dụ: Cẩm nang ẩm thực" /></label>
          <label class="system-post-field"><span>Tóm tắt</span><textarea name="summaryVi" rows="4" maxlength="300" placeholder="Mô tả ngắn nội dung bài viết"><%= values.summaryVi || '' %></textarea><small><span data-count-for="summaryVi">0</span>/300 ký tự</small></label>
          <label class="system-post-field"><span>Nội dung <b>*</b></span><textarea name="contentVi" rows="15" placeholder="Soạn nội dung bài viết tại đây..." required><%= values.contentVi || '' %></textarea><small><span data-count-for="contentVi">0</span> ký tự</small></label>
        </div>

        <div class="system-post-language-panel" data-language-panel="en" hidden>
          <label class="system-post-field"><span>Article title</span><input type="text" name="titleEn" value="<%= values.titleEn || '' %>" placeholder="Enter the English title" /></label>
          <label class="system-post-field"><span>Category</span><input type="text" name="categoryEn" value="<%= values.categoryEn || '' %>" placeholder="For example: Food guide" /></label>
          <label class="system-post-field"><span>Summary</span><textarea name="summaryEn" rows="4" maxlength="300" placeholder="Brief English description"><%= values.summaryEn || '' %></textarea><small><span data-count-for="summaryEn">0</span>/300 characters</small></label>
          <label class="system-post-field"><span>Content</span><textarea name="contentEn" rows="15" placeholder="Write the English content here..."><%= values.contentEn || '' %></textarea><small><span data-count-for="contentEn">0</span> characters</small></label>
        </div>
      </section>

      <section class="system-post-editor-card">
        <div class="system-post-editor-card__head"><div><span class="system-posts-eyebrow">Tìm kiếm</span><h3>Tối ưu SEO</h3></div><span class="system-post-editor-card__hint">Không bắt buộc</span></div>
        <div class="system-post-seo-grid">
          <label class="system-post-field"><span>SEO title</span><input type="text" name="seoTitle" maxlength="70" value="<%= values.seoTitle || '' %>" placeholder="Tiêu đề trên công cụ tìm kiếm" /><small><span data-count-for="seoTitle">0</span>/70 ký tự</small></label>
          <label class="system-post-field"><span>SEO description</span><textarea name="seoDescription" maxlength="160" rows="3" placeholder="Mô tả hiển thị trên kết quả tìm kiếm"><%= values.seoDescription || '' %></textarea><small><span data-count-for="seoDescription">0</span>/160 ký tự</small></label>
        </div>
        <div class="system-post-seo-preview"><span>foodtravel.vn</span><strong id="system-post-seo-preview-title"><%= values.seoTitle || values.titleVi || 'Tiêu đề bài viết' %></strong><p id="system-post-seo-preview-description"><%= values.seoDescription || values.summaryVi || 'Mô tả bài viết sẽ xuất hiện tại đây.' %></p></div>
      </section>
    </main>

    <aside class="system-post-editor__sidebar">
      <section class="system-post-editor-card">
        <div class="system-post-editor-card__head"><div><span class="system-posts-eyebrow">Phân phối</span><h3>Xuất bản</h3></div></div>
        <label class="system-post-field"><span>Trạng thái</span><select name="status"><% statuses.forEach(function(item) { %><option value="<%= item.value %>" <%= values.status === item.value ? 'selected' : '' %>><%= item.label %></option><% }) %></select></label>
        <label class="system-post-field"><span>Đường dẫn (slug) <b>*</b></span><div class="system-post-slug"><input type="text" id="system-post-slug" name="slug" value="<%= values.slug || '' %>" required /><button type="button" id="system-post-generate-slug">Tạo</button></div></label>
        <label class="system-post-field"><span>Tỉnh / thành</span><select name="provinceCode34"><option value="">Toàn quốc</option><% provinces.forEach(function(item) { %><option value="<%= item.code %>" <%= values.provinceCode34 === item.code ? 'selected' : '' %> data-name="<%= item.name %>" data-region="<%= item.regionCode %>"><%= item.name %></option><% }) %></select></label>
        <input type="hidden" name="provinceName34" value="<%= values.provinceName34 || '' %>" /><input type="hidden" name="regionCode" value="<%= values.regionCode || '' %>" />
        <div class="system-post-switches">
          <label><span><strong>Nội dung nổi bật</strong><small>Ưu tiên hiển thị trên ứng dụng</small></span><input type="checkbox" name="featured" value="true" <%= values.featured ? 'checked' : '' %> /><i></i></label>
          <label><span><strong>Ghim bài viết</strong><small>Giữ bài viết ở vị trí ưu tiên</small></span><input type="checkbox" name="pinned" value="true" <%= values.pinned ? 'checked' : '' %> /><i></i></label>
        </div>
      </section>

      <section class="system-post-editor-card">
        <div class="system-post-editor-card__head"><div><span class="system-posts-eyebrow">Hình ảnh</span><h3>Ảnh bìa</h3></div></div>
        <div class="system-post-cover <%= values.coverImage ? 'has-image' : '' %>" id="system-post-cover-preview">
          <img id="system-post-cover-preview-image" src="<%= values.coverImage || '' %>" alt="Xem trước ảnh bìa" />
          <div class="system-post-cover__placeholder"><span aria-hidden="true">▧</span><strong>Chọn ảnh bìa</strong><small>PNG, JPG hoặc WebP</small></div>
          <button type="button" id="system-post-upload-trigger">Thay đổi ảnh</button>
        </div>
        <input type="file" id="system-post-cover-file" accept="image/png,image/jpeg,image/webp" hidden />
        <label class="system-post-field system-post-cover-url"><span>Hoặc sử dụng URL</span><input type="url" id="system-post-cover-image" name="coverImage" value="<%= values.coverImage || '' %>" placeholder="https://..." /></label>
        <small class="system-post-upload-status" id="system-post-upload-status">Ảnh ngang tỷ lệ 16:9 cho kết quả tốt nhất.</small>
      </section>

      <section class="system-post-editor-card">
        <div class="system-post-editor-card__head"><div><span class="system-posts-eyebrow">Phân loại</span><h3>Thẻ nội dung</h3></div></div>
        <label class="system-post-field"><span>Tags</span><input type="text" name="tags" value="<%= values.tags || '' %>" placeholder="cẩm nang, nổi bật, đặc sản" /><small>Phân tách mỗi thẻ bằng dấu phẩy.</small></label>
        <% if (values.id) { %><label class="system-post-field"><span>ID bài viết</span><input type="text" name="id" value="<%= values.id %>" readonly /></label><% } else { %><input type="hidden" name="id" value="" /><% } %>
      </section>

      <section class="system-post-editor-card system-post-checklist">
        <div class="system-post-editor-card__head"><div><span class="system-posts-eyebrow">Kiểm tra</span><h3>Mức độ hoàn thiện</h3></div><strong id="system-post-progress">0%</strong></div>
        <div class="system-post-progress"><i id="system-post-progress-bar"></i></div>
        <ul><li data-check="title">Tiêu đề tiếng Việt</li><li data-check="content">Nội dung tiếng Việt</li><li data-check="cover">Ảnh bìa</li><li data-check="summary">Tóm tắt bài viết</li><li data-check="seo">Thông tin SEO</li></ul>
      </section>
    </aside>

    <input type="hidden" name="title" value="<%= values.titleVi || '' %>" /><input type="hidden" name="summary" value="<%= values.summaryVi || '' %>" /><input type="hidden" name="content" value="<%= values.contentVi || '' %>" /><input type="hidden" name="category" value="<%= values.categoryVi || '' %>" />
  </form>

  <div class="system-post-editor__mobile-actions"><a class="secondary-button" href="/admin/system-posts">Hủy</a><button class="primary-button" type="submit" form="system-post-form">Lưu bài viết</button></div>
</section>
