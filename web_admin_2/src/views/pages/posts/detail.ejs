<link rel="stylesheet" href="/public/css/pages/posts.css" />

<section class="post-detail-page">
  <div class="post-detail-breadcrumb">
    <a href="/admin/posts">Quản lý bài viết</a>
    <span>/</span>
    <span>Chi tiết bài viết</span>
  </div>

  <div class="post-detail-top">
    <article class="post-detail-hero">
      <div class="post-detail-hero__media">
        <% if (post.coverImage) { %>
          <img src="<%= post.coverImage %>" alt="" />
        <% } else { %>
          <div class="post-detail-hero__empty">Chưa có ảnh bài viết</div>
        <% } %>
      </div>

      <div class="post-detail-hero__content">
        <div class="post-detail-hero__author">
          <% if (post.authorPhoto) { %>
            <img class="post-detail-avatar" src="<%= post.authorPhoto %>" alt="" />
          <% } else { %>
            <div class="post-detail-avatar post-detail-avatar--empty">
              <%= (post.authorName || 'A').charAt(0).toUpperCase() %>
            </div>
          <% } %>

          <div>
            <strong><%= post.authorName || 'Ẩn danh' %></strong>
            <span><%= post.authorUsername || post.authorId || '-' %></span>
          </div>
        </div>

        <div class="post-detail-badges">
          <span class="post-detail-chip"><%= post.postType %></span>
          <span class="post-detail-chip post-detail-chip--status"><%= post.moderationStatus %></span>
          <% if (post.isEdited) { %>
            <span class="post-detail-chip">Đã chỉnh sửa</span>
          <% } %>
        </div>

        <div class="post-detail-title">
          <h1><%= post.title || 'Bài viết cộng đồng' %></h1>
          <p><%= post.text || 'Không có nội dung.' %></p>
        </div>

        <div class="post-detail-meta-grid">
          <div class="post-detail-mini-card">
            <strong><%= post.placeName || '-' %></strong>
            <span>Địa điểm liên quan</span>
          </div>

          <div class="post-detail-mini-card">
            <strong><%= post.provinceName34 || '-' %></strong>
            <span>Tỉnh / thành</span>
          </div>

          <div class="post-detail-mini-card">
            <strong><%= post.mediaCount %></strong>
            <span>Số media</span>
          </div>

          <div class="post-detail-mini-card">
            <strong><%= post.visibility %></strong>
            <span>Hiển thị</span>
          </div>
        </div>
      </div>
    </article>

    <aside class="post-detail-side">
      <section class="post-detail-panel">
        <h3>Thông tin nhanh</h3>
        <dl class="post-detail-facts">
          <div>
            <dt>ID</dt>
            <dd><%= post.id %></dd>
          </div>
          <div>
            <dt>Tác giả</dt>
            <dd><%= post.authorName || '-' %></dd>
          </div>
          <div>
            <dt>Loại bài</dt>
            <dd><%= post.postType || '-' %></dd>
          </div>
          <div>
            <dt>Kiểm duyệt</dt>
            <dd><%= post.moderationStatus || '-' %></dd>
          </div>
          <div>
            <dt>Ngày tạo</dt>
            <dd>
              <%= post.createdAtDate ? post.createdAtDate.toLocaleDateString('vi-VN') : '-' %>
              <% if (post.createdAtDate) { %>
                - <%= post.createdAtDate.toLocaleTimeString('vi-VN') %>
              <% } %>
            </dd>
          </div>
          <div>
            <dt>Cập nhật</dt>
            <dd>
              <%= post.updatedAtDate ? post.updatedAtDate.toLocaleDateString('vi-VN') : '-' %>
              <% if (post.updatedAtDate) { %>
                - <%= post.updatedAtDate.toLocaleTimeString('vi-VN') %>
              <% } %>
            </dd>
          </div>
        </dl>
      </section>

      <section class="post-detail-panel">
        <h3>Tương tác</h3>
        <div class="post-detail-stats">
          <div class="post-detail-stat">
            <strong><%= post.likeCount %></strong>
            <span>Lượt thích</span>
          </div>
          <div class="post-detail-stat">
            <strong><%= post.commentCount %></strong>
            <span>Bình luận</span>
          </div>
          <div class="post-detail-stat">
            <strong><%= post.viewCount %></strong>
            <span>Lượt xem</span>
          </div>
          <div class="post-detail-stat">
            <strong><%= post.reportCount %></strong>
            <span>Báo cáo</span>
          </div>
        </div>
      </section>
    </aside>
  </div>

  <% if (post.media && post.media.length) { %>
    <section class="post-detail-card">
      <div class="post-detail-card__header">
        <h3>Danh sách media</h3>
      </div>

      <div class="post-detail-media-grid">
        <% post.media.forEach(function(item) { %>
          <div class="post-detail-media-item">
            <img src="<%= item.url %>" alt="" />
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>

  <div class="post-detail-bottom">
    <section class="post-detail-card">
      <div class="post-detail-card__header">
        <h3>Bình luận gần nhất</h3>
      </div>

      <% if (post.comments && post.comments.length) { %>
        <div class="post-detail-comments">
          <% post.comments.forEach(function(comment) { %>
            <article class="post-detail-comment">
              <% if (comment.authorPhoto) { %>
                <img class="post-detail-comment__avatar" src="<%= comment.authorPhoto %>" alt="" />
              <% } else { %>
                <div class="post-detail-comment__avatar post-detail-comment__avatar--empty">
                  <%= (comment.authorName || 'A').charAt(0).toUpperCase() %>
                </div>
              <% } %>

              <div class="post-detail-comment__body">
                <div class="post-detail-comment__head">
                  <strong><%= comment.authorName || 'Ẩn danh' %></strong>
                  <span>
                    <%= comment.createdAtDate ? comment.createdAtDate.toLocaleDateString('vi-VN') : '-' %>
                  </span>
                </div>
                <p><%= comment.text || '-' %></p>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <div class="post-detail-empty">Chưa có bình luận nào.</div>
      <% } %>
    </section>

    <section class="post-detail-card">
      <div class="post-detail-card__header">
        <h3>Lượt thích gần nhất</h3>
      </div>

      <% if (post.likes && post.likes.length) { %>
        <div class="post-detail-likes">
          <% post.likes.forEach(function(like) { %>
            <div class="post-detail-like-item">
              <strong><%= like.id %></strong>
              <span>
                <%= like.createdAtDate ? like.createdAtDate.toLocaleDateString('vi-VN') : '-' %>
              </span>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="post-detail-empty">Chưa có dữ liệu lượt thích.</div>
      <% } %>
    </section>
  </div>
</section>