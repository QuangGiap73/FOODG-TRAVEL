<link rel="stylesheet" href="/public/css/pages/provinces.css" />

<%
  const totalProvinces = initialProvinces.length;
  const totalRegions = initialRegions.length;
  const totalDishes = initialProvinces.reduce((sum, province) => sum + Number(province.dishesCount || 0), 0);
  const totalCheckins = initialProvinces.reduce((sum, province) => sum + Number(province.checkinsCount || 0), 0);
%>

<section class="provinces-page provinces-page--provinces">
  <article class="panel-card provinces-page__content provinces-page__content--full">
    <div class="provinces-hero">
      <div class="provinces-hero__text">
        <p class="provinces-hero__eyebrow">DỮ LIỆU NỀN</p>
        <h2>Tỉnh thành &amp; vùng miền</h2>
        <p>Quản lý miền và tỉnh thành để đồng bộ cho các module địa điểm, món ăn và hành trình.</p>
        <div class="provinces-hero__breadcrumb">Dashboard &nbsp;&gt;&nbsp; <strong>Tỉnh thành</strong></div>
      </div>
      <div class="provinces-hero__quick">
        <a class="secondary-button provinces-action-button" href="/admin/provinces/regions">Quản lý vùng miền</a>
      </div>
    </div>

    <div class="provinces-stats">
      <div class="provinces-stat-card">
        <div class="provinces-stat-card__icon orange">🏙</div>
        <div>
          <p>Tỉnh thành</p>
          <strong><%= totalProvinces.toLocaleString('vi-VN') %></strong>
          <small><%= totalProvinces === 34 ? '100% đầy đủ dữ liệu' : 'Đang đồng bộ dữ liệu' %></small>
        </div>
      </div>
      <div class="provinces-stat-card">
        <div class="provinces-stat-card__icon green">🗺</div>
        <div>
          <p>Vùng miền</p>
          <strong><%= totalRegions.toLocaleString('vi-VN') %></strong>
          <small>Tổng vùng dữ liệu</small>
        </div>
      </div>
      <div class="provinces-stat-card">
        <div class="provinces-stat-card__icon yellow">🍲</div>
        <div>
          <p>Món đặc sản</p>
          <strong><%= totalDishes.toLocaleString('vi-VN') %></strong>
          <small>Thuộc theo miền</small>
        </div>
      </div>
      <div class="provinces-stat-card">
        <div class="provinces-stat-card__icon purple">📍</div>
        <div>
          <p>Lượt check-in</p>
          <strong><%= totalCheckins.toLocaleString('vi-VN') %></strong>
          <small>Theo vùng miền</small>
        </div>
      </div>
    </div>

    <div class="provinces-toolbar-bar">
      <div class="provinces-toolbar">
        <label class="provinces-search">
          <input id="province-search" type="search" placeholder="Tìm theo tên tỉnh..." />
        </label>
        <select id="province-region-filter">
          <option value="">Tất cả miền</option>
          <% initialRegions.forEach(function(region) { %>
            <option value="<%= region.code %>"><%= region.name %></option>
          <% }) %>
        </select>
        <button class="secondary-button provinces-action-button" type="button" id="province-reset">Đặt lại</button>
        <button class="primary-button provinces-action-button provinces-action-button--primary" type="button" id="province-open-create">＋ Thêm tỉnh thành</button>
      </div>
    </div>

    <div class="provinces-table-meta">
      <strong id="province-table-title">Tất cả 34 tỉnh thành</strong>
      <span id="province-count"><%= totalProvinces %> tỉnh</span>
    </div>

    <div class="table-shell">
      <table class="data-table">
        <thead>
          <tr>
            <th><input type="checkbox" id="province-check-all" /></th>
            <th>Ảnh</th>
            <th>Tên tỉnh</th>
            <th>Miền</th>
            <th>Số món</th>
            <th>Số check-in</th>
            <th>Tọa độ</th>
            <th>Thao tác</th>
          </tr>
        </thead>
        <tbody id="provinces-table-body">
          <% initialProvinces.forEach(function(province) { %>
            <tr>
              <td><input type="checkbox" class="province-row-check" value="<%= province.code %>" /></td>
              <td>
                <div class="province-thumb">
                  <% if (province.imageUrl) { %>
                    <img src="<%= province.imageUrl %>" alt="<%= province.name %>" />
                  <% } else { %>
                    <span><%= province.name ? province.name.charAt(0) : 'P' %></span>
                  <% } %>
                </div>
              </td>
              <td><%= province.name %></td>
              <td><%= province.regionsCode %></td>
              <td><%= province.dishesCount || 0 %></td>
              <td><%= province.checkinsCount || 0 %></td>
              <td><%= province.centerLat || 0 %>, <%= province.centerLng || 0 %></td>
              <td class="table-actions">
                <details class="provinces-action-menu">
                  <summary class="provinces-action-menu__trigger" aria-label="Mở menu thao tác">
                    <span></span>
                    <span></span>
                    <span></span>
                  </summary>
                  <div class="provinces-action-menu__dropdown">
                    <button class="provinces-action-menu__item" type="button" data-province-view="<%= province.code %>">Xem</button>
                    <button
                      class="provinces-action-menu__item"
                      type="button"
                      data-province-edit="<%= province.code %>"
                      data-province-code="<%= province.code %>"
                      data-province-name="<%= province.name || '' %>"
                      data-province-region="<%= province.regionsCode || '' %>"
                      data-province-slug="<%= province.slug || '' %>"
                      data-province-lat="<%= province.centerLat || 0 %>"
                      data-province-lng="<%= province.centerLng || 0 %>"
                      data-province-description="<%= province.description || '' %>"
                      data-province-image-url="<%= province.imageUrl || '' %>"
                      data-province-image-urls="<%= Array.isArray(province.imageUrls) ? province.imageUrls.join('\n') : '' %>"
                    >
                      Sửa
                    </button>
                    <button class="provinces-action-menu__item provinces-action-menu__item--danger" type="button" data-province-delete="<%= province.code %>">Xóa</button>
                  </div>
                </details>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </article>
</section>

<div class="province-modal-backdrop" id="province-modal-backdrop"></div>

<section class="province-modal" id="province-modal" role="dialog" aria-modal="true" aria-labelledby="province-modal-title" aria-hidden="true" tabindex="-1">
  <div class="province-modal__header">
    <div>
      <h4 id="province-modal-title">Thêm tỉnh thành</h4>
      <p class="provinces-muted">Form này dùng cho cả thêm mới và chỉnh sửa.</p>
    </div>
    <button class="icon-action" type="button" id="province-modal-close">Đóng</button>
  </div>

  <form id="province-form" class="user-form-grid provinces-form">
    <label>
      <span>Mã tỉnh</span>
      <input id="province-code" type="text" placeholder="ha_noi" />
    </label>
    <label>
      <span>Tên tỉnh</span>
      <input id="province-name" type="text" placeholder="Hà Nội" />
    </label>
    <label>
      <span>Thuộc miền</span>
      <select id="province-region">
        <option value="">Chọn miền</option>
        <% initialRegions.forEach(function(region) { %>
          <option value="<%= region.code %>"><%= region.name %></option>
        <% }) %>
      </select>
    </label>
    <label>
      <span>Slug</span>
      <input id="province-slug" type="text" placeholder="ha-noi" />
    </label>
    <label>
      <span>Vĩ độ</span>
      <input id="province-lat" type="number" step="any" placeholder="21.028511" />
    </label>
    <label>
      <span>Kinh độ</span>
      <input id="province-lng" type="number" step="any" placeholder="105.804817" />
    </label>
    <label>
      <span>Dân số</span>
      <input id="province-population" type="text" placeholder="8.435.000" />
    </label>
    <label>
      <span>Diện tích (km²)</span>
      <input id="province-area-km2" type="text" placeholder="3,359" />
    </label>
    <label>
      <span>Ngày thành lập</span>
      <input id="province-established-date" type="text" placeholder="1010" />
    </label>
    <label>
      <span>Biển số xe</span>
      <input id="province-vehicle-plate" type="text" placeholder="29, 30, 31..." />
    </label>
    <label>
      <span>Mã tỉnh/thành</span>
      <input id="province-code-label" type="text" placeholder="ha_noi" />
    </label>
    <label class="user-form-grid__full">
      <span>Mô tả tiếng Anh</span>
      <textarea id="province-description-en" rows="3" placeholder="English description..."></textarea>
    </label>
    <label class="user-form-grid__full">
      <span>Mô tả</span>
      <textarea id="province-description" rows="3" placeholder="Mô tả ngắn về tỉnh thành..."></textarea>
    </label>
    <div class="user-form-grid__full provinces-place-editor">
      <div class="provinces-place-editor__header">
        <span>Danh sách địa điểm nổi bật</span>
      </div>
      <div id="province-place-list" class="provinces-place-list"></div>
      <div class="provinces-place-editor__footer">
        <button type="button" class="secondary-button" id="province-place-add">+ Thêm địa điểm</button>
      </div>
      <p class="provinces-muted">Mỗi địa điểm có thể lưu tên Việt/Anh và chọn ảnh từ máy hoặc nhập URL.</p>
    </div>
    <label class="user-form-grid__full">
      <span>Danh sách ảnh URL (mỗi dòng một link)</span>
      <textarea id="province-images" rows="4" placeholder="https://..."></textarea>
    </label>
    <label class="user-form-grid__full">
      <span>Tải ảnh từ máy</span>
      <input id="province-image-files" type="file" accept="image/*" multiple />
    </label>
    <div class="user-form-grid__full provinces-preview-list" id="province-image-preview"></div>
    <p class="form-error user-form-grid__full" id="province-error"></p>
    <div class="user-form-actions user-form-grid__full">
      <button type="button" class="secondary-button" id="province-modal-cancel">Hủy</button>
      <button type="submit" class="primary-button" id="province-submit-button">Lưu tỉnh thành</button>
    </div>
  </form>
</section>

<aside class="province-drawer" id="province-drawer" role="dialog" aria-modal="true" aria-labelledby="province-drawer-title" aria-hidden="true" tabindex="-1">
  <div class="province-drawer__header">
    <div>
      <h4 id="province-drawer-title">Chi tiết tỉnh thành</h4>
      <p class="provinces-muted">Xem nhanh thông tin đang lưu trên hệ thống.</p>
    </div>
    <button class="icon-action" type="button" id="province-drawer-close">Đóng</button>
  </div>
  <div class="province-drawer__hero">
    <div class="province-drawer__image" id="province-drawer-image-wrap">
      <img id="province-drawer-image" alt="" />
      <span>Không có ảnh</span>
    </div>
    <div class="province-drawer__summary">
      <h5 id="province-drawer-name">-</h5>
      <p id="province-drawer-code">-</p>
      <span id="province-drawer-region" class="provinces-chip">-</span>
    </div>
  </div>
  <div class="province-drawer__body">
    <div class="province-drawer__row"><span>Slug</span><strong id="province-drawer-slug">-</strong></div>
    <div class="province-drawer__row"><span>Số món</span><strong id="province-drawer-dishes">0</strong></div>
    <div class="province-drawer__row"><span>Số check-in</span><strong id="province-drawer-checkins">0</strong></div>
    <div class="province-drawer__row"><span>Dân số</span><strong id="province-drawer-population">-</strong></div>
    <div class="province-drawer__row"><span>Diện tích</span><strong id="province-drawer-area">-</strong></div>
    <div class="province-drawer__row"><span>Ngày thành lập</span><strong id="province-drawer-established">-</strong></div>
    <div class="province-drawer__row"><span>Biển số xe</span><strong id="province-drawer-plate">-</strong></div>
    <div class="province-drawer__row"><span>Mã tỉnh/thành</span><strong id="province-drawer-code-label">-</strong></div>
    <div class="province-drawer__row"><span>Tọa độ</span><strong id="province-drawer-coordinates">-</strong></div>
    <div class="province-drawer__row"><span>Ngày tạo</span><strong id="province-drawer-created">-</strong></div>
    <div class="province-drawer__row"><span>Cập nhật</span><strong id="province-drawer-updated">-</strong></div>
    <div class="province-drawer__block">
      <span>Mô tả tiếng Anh</span>
      <p id="province-drawer-description-en">-</p>
    </div>
    <div class="province-drawer__block">
      <span>Mô tả</span>
      <p id="province-drawer-description">-</p>
    </div>
    <div class="province-drawer__block">
      <span>Địa điểm nổi bật</span>
      <div class="province-drawer__places" id="province-drawer-places"></div>
    </div>
    <div class="province-drawer__block">
      <span>Bộ ảnh</span>
      <div class="province-drawer__gallery" id="province-drawer-gallery"></div>
    </div>
  </div>
</aside>

<div class="province-drawer-backdrop" id="province-drawer-backdrop"></div>

<script>
  window.__PROVINCES_INITIAL__ = {
    regions: <%- JSON.stringify(initialRegions) %>,
    provinces: <%- JSON.stringify(initialProvinces) %>,
  };
</script>
<script src="/public/js/modules/provinces/index.js"></script>
