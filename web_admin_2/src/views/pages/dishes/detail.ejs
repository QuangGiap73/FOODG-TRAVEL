<link rel="stylesheet" href="/public/css/pages/dishes.css" />

<section class="dish-detail-page dish-detail-page--mockup" data-dish-detail-page>
  <div class="dish-detail-topbar">
    <div class="dish-detail-breadcrumb">
      <a href="/admin/dishes">Quản lý món ăn</a>
      <span>/</span>
      <strong>Chi tiết món ăn</strong>
    </div>

    <div class="dish-detail-language-switch" role="tablist" aria-label="Ngôn ngữ hiển thị">
      <button type="button" class="is-active" data-lang-button="vi">VI</button>
      <button type="button" data-lang-button="en">EN</button>
    </div>
  </div>

  <div class="dish-detail-hero-row">
    <article class="dish-detail-hero-card">
      <div class="dish-detail-hero-card__media">
        <% if (dish.imageUrl) { %>
          <img src="<%= dish.imageUrl %>" alt="<%= dish.nameVi %>" />
        <% } else { %>
          <div class="dish-detail-hero-card__empty">Chưa có ảnh món ăn</div>
        <% } %>
      </div>

      <div class="dish-detail-hero-card__content">
        <div class="dish-detail-hero-card__title">
          <h1 data-lang-vi="<%= dish.nameVi || '-' %>" data-lang-en="<%= dish.nameEn || '-' %>" title="<%= dish.nameVi || '-' %>"><%= dish.nameVi || '-' %></h1>
          <p data-lang-vi="<%= dish.nameEn || '-' %>" data-lang-en="<%= dish.nameEn || '-' %>" title="<%= dish.nameEn || '-' %>"><%= dish.nameEn || '-' %></p>
        </div>

        <div class="dish-detail-hero-card__badges">
          <span class="dish-detail-pill">STT: #<%= dish.stt || 0 %></span>
          <span class="dish-detail-pill dish-detail-pill--success">Đã xuất bản</span>
        </div>

        <div class="dish-detail-hero-card__meta">
          <div class="dish-detail-mini-card">
            <strong><%= dish.provinceName34 || '-' %></strong>
            <span>Tỉnh/thành hiện tại</span>
          </div>
          <div class="dish-detail-mini-card">
            <strong><%= dish.legacyProvinceCode || '-' %></strong>
            <span>Nguồn gốc/tỉnh cũ</span>
          </div>
          <div class="dish-detail-mini-card">
            <strong><%= dish.regionCode || '-' %></strong>
            <span>Vùng miền</span>
          </div>
          <div class="dish-detail-mini-card dish-detail-mini-card--accent">
            <strong data-lang-vi="<%= dish.categoryVi || '-' %>" data-lang-en="<%= dish.categoryEn || '-' %>" title="<%= dish.categoryVi || '-' %>"><%= dish.categoryVi || '-' %></strong>
            <span>Danh mục</span>
          </div>
        </div>

        <div class="dish-detail-expandable" data-expandable data-lines="3">
          <p class="dish-detail-hero-card__summary" data-lang-vi="<%= dish.descriptionVi || 'Chưa có mô tả ngắn cho món ăn này.' %>" data-lang-en="<%= dish.descriptionEn || 'No short description available for this dish.' %>"><%= dish.descriptionVi || 'Chưa có mô tả ngắn cho món ăn này.' %></p>
          <button type="button" class="dish-detail-toggle" data-expand-toggle hidden>Xem thêm</button>
        </div>
      </div>
    </article>

    <aside class="dish-detail-side-card">
      <section class="dish-detail-panel dish-detail-panel--compact">
        <h3>Thông tin nhanh</h3>
        <dl class="dish-detail-quick-list" data-facts-list>
          <div>
            <dt>Danh mục</dt>
            <dd class="dish-detail-fact-value" data-lang-vi="<%= dish.categoryVi || '-' %>" data-lang-en="<%= dish.categoryEn || '-' %>"><%= dish.categoryVi || '-' %></dd>
          </div>
          <div>
            <dt>Thời điểm ăn</dt>
            <dd class="dish-detail-fact-value" data-lang-vi="<%= dish.bestTimeVi || '-' %>" data-lang-en="<%= dish.bestTimeEn || '-' %>"><%= dish.bestTimeVi || '-' %></dd>
          </div>
          <div>
            <dt>Mùa phù hợp</dt>
            <dd class="dish-detail-fact-value" data-lang-vi="<%= dish.bestSeasonVi || '-' %>" data-lang-en="<%= dish.bestSeasonEn || '-' %>"><%= dish.bestSeasonVi || '-' %></dd>
          </div>
          <div>
            <dt>Giá</dt>
            <dd class="dish-detail-fact-value" data-lang-vi="<%= dish.priceRangeVi || '-' %>" data-lang-en="<%= dish.priceRangeEn || '-' %>"><%= dish.priceRangeVi || '-' %></dd>
          </div>
          <div>
            <dt>dishTypeCodes</dt>
            <dd><%= dish.dishTypeCodes.length ? dish.dishTypeCodes.join(', ') : '-' %></dd>
          </div>
          <div>
            <dt>mealTimeTags</dt>
            <dd><%= dish.mealTimeTags.length ? dish.mealTimeTags.join(', ') : '-' %></dd>
          </div>
          <div>
            <dt>ingredientsListNormalized</dt>
            <dd><%= dish.ingredientsListNormalized.length ? dish.ingredientsListNormalized.join(', ') : '-' %></dd>
          </div>
          <div>
            <dt>Tên món</dt>
            <dd class="dish-detail-fact-value" data-lang-vi="<%= dish.nameVi || '-' %>" data-lang-en="<%= dish.nameEn || '-' %>"><%= dish.nameVi || '-' %></dd>
          </div>
          <div>
            <dt>Cập nhật</dt>
            <dd><%= dish.updatedAtLabel || '-' %></dd>
          </div>
        </dl>
        <button type="button" class="dish-detail-toggle dish-detail-toggle--panel" data-facts-toggle hidden>Xem tất cả</button>
      </section>
    </aside>
  </div>

  <div class="dish-detail-summary-row">
    <div class="dish-detail-stats-grid">
      <article class="dish-detail-summary-card">
        <span>Giá tham khảo</span>
        <strong data-lang-vi="<%= dish.priceRangeVi || '-' %>" data-lang-en="<%= dish.priceRangeEn || '-' %>"><%= dish.priceRangeVi || '-' %></strong>
      </article>
      <article class="dish-detail-summary-card">
        <span>Thời điểm ăn ngon</span>
        <strong data-lang-vi="<%= dish.bestTimeVi || '-' %>" data-lang-en="<%= dish.bestTimeEn || '-' %>"><%= dish.bestTimeVi || '-' %></strong>
      </article>
      <article class="dish-detail-summary-card">
        <span>Mùa phù hợp</span>
        <strong data-lang-vi="<%= dish.bestSeasonVi || '-' %>" data-lang-en="<%= dish.bestSeasonEn || '-' %>"><%= dish.bestSeasonVi || '-' %></strong>
      </article>
      <article class="dish-detail-summary-card">
        <span>Độ cay</span>
        <strong><%= dish.spicyLevel %>/5</strong>
      </article>
      <article class="dish-detail-summary-card">
        <span>Độ no</span>
        <strong><%= dish.satietyLevel %>/5</strong>
      </article>
      <article class="dish-detail-summary-card">
        <span>Cập nhật</span>
        <strong><%= dish.updatedAtLabel || '-' %></strong>
      </article>
    </div>

    <aside class="dish-detail-stats-side">
      <section class="dish-detail-panel dish-detail-panel--compact">
        <h3>Trạng thái dữ liệu</h3>
        <ul class="dish-detail-status-list">
          <li class="<%= dish.nameEn && dish.descriptionEn ? 'is-ok' : 'is-warn' %>">Song ngữ đầy đủ</li>
          <li class="<%= dish.imageUrl ? 'is-ok' : 'is-warn' %>">Có ảnh đại diện</li>
          <li class="<%= dish.tagList.length || dish.tagListEn.length ? 'is-ok' : 'is-warn' %>">Có tags</li>
          <li class="<%= dish.originStoryVi || dish.originStoryEn ? 'is-ok' : 'is-warn' %>">Có mô tả nguồn gốc</li>
        </ul>
      </section>
    </aside>
  </div>

  <div class="dish-detail-tabs dish-detail-tabs--mockup">
    <span class="is-active">Tổng quan</span>
    <span>Song ngữ</span>
    <span>Nguyên liệu</span>
    <span>Cách làm</span>
    <span>Nguồn gốc</span>
    <span>Tags & SEO</span>
    <span>Hình ảnh</span>
  </div>

  <div class="dish-detail-content dish-detail-content--mockup">
    <section class="dish-detail-main">
      <div class="dish-detail-two-col">
        <article class="dish-detail-card dish-detail-card--compact">
          <div class="dish-detail-card__header">
            <h3>Thông tin cơ bản</h3>
          </div>
          <dl class="dish-detail-basic dish-detail-basic--compact">
            <div><dt>ID</dt><dd><%= dish.id || '-' %></dd></div>
            <div><dt>Slug</dt><dd><%= dish.slug || '-' %></dd></div>
            <div><dt>provinceName34</dt><dd><%= dish.provinceName34 || '-' %></dd></div>
            <div><dt>legacyProvinceCode</dt><dd><%= dish.legacyProvinceCode || '-' %></dd></div>
            <div><dt>region_code</dt><dd><%= dish.regionCode || '-' %></dd></div>
          </dl>
        </article>

        <article class="dish-detail-card dish-detail-card--compact">
          <div class="dish-detail-card__header">
            <h3>Mô tả</h3>
          </div>
          <div class="dish-detail-bilingual dish-detail-bilingual--compact">
            <div class="dish-detail-expandable" data-expandable data-lines="5">
              <span>VI</span>
              <p data-lang-vi="<%= dish.descriptionVi || '-' %>" data-lang-en="<%= dish.descriptionVi || '-' %>"><%= dish.descriptionVi || '-' %></p>
              <button type="button" class="dish-detail-toggle" data-expand-toggle hidden>Xem thêm</button>
            </div>
            <div class="dish-detail-expandable" data-expandable data-lines="5">
              <span>EN</span>
              <p data-lang-vi="<%= dish.descriptionEn || '-' %>" data-lang-en="<%= dish.descriptionEn || '-' %>"><%= dish.descriptionEn || '-' %></p>
              <button type="button" class="dish-detail-toggle" data-expand-toggle hidden>Xem thêm</button>
            </div>
          </div>
        </article>
      </div>

      <article class="dish-detail-card dish-detail-card--compact">
        <div class="dish-detail-card__header">
          <h3>Nguyên liệu</h3>
        </div>
        <div class="dish-detail-tag-wrap dish-detail-tag-wrap--lang" data-lang-list-vi="<%- JSON.stringify(dish.ingredientList || []) %>" data-lang-list-en="<%- JSON.stringify(dish.ingredientListEn || []) %>" data-list-variant="tag">
          <% if (dish.ingredientList.length) { %>
            <% dish.ingredientList.forEach(function (item) { %>
              <span class="dish-detail-tag"><%= item %></span>
            <% }) %>
          <% } else { %>
            <span>-</span>
          <% } %>
        </div>
      </article>

      <article class="dish-detail-card dish-detail-card--compact">
        <div class="dish-detail-card__header">
          <h3>Metadata goi y</h3>
        </div>
        <dl class="dish-detail-basic dish-detail-basic--compact">
          <div><dt>dishTypeCodes</dt><dd><%= dish.dishTypeCodes.length ? dish.dishTypeCodes.join(', ') : '-' %></dd></div>
          <div><dt>mealTimeTags</dt><dd><%= dish.mealTimeTags.length ? dish.mealTimeTags.join(', ') : '-' %></dd></div>
          <div><dt>suitableForSeason</dt><dd><%= dish.suitableForSeason.length ? dish.suitableForSeason.join(', ') : '-' %></dd></div>
          <div><dt>ingredientsListNormalized</dt><dd><%= dish.ingredientsListNormalized.length ? dish.ingredientsListNormalized.join(', ') : '-' %></dd></div>
        </dl>
      </article>

      <div class="dish-detail-two-col">
        <article class="dish-detail-card dish-detail-card--compact">
          <div class="dish-detail-card__header">
            <h3>Cách làm</h3>
          </div>
          <div class="dish-detail-steps dish-detail-steps--compact dish-detail-steps--lang" data-lang-list-vi="<%- JSON.stringify((dish.instructionSteps || []).slice(0, 6)) %>" data-lang-list-en="<%- JSON.stringify((dish.instructionStepsEn || []).slice(0, 6)) %>" data-list-variant="step">
            <% if (dish.instructionSteps.length) { %>
              <% dish.instructionSteps.slice(0, 6).forEach(function (step, index) { %>
                <div class="dish-detail-step">
                  <span><%= index + 1 %></span>
                  <p><%= step %></p>
                </div>
              <% }) %>
            <% } else { %>
              <p>-</p>
            <% } %>
          </div>
        </article>

        <article class="dish-detail-card dish-detail-card--compact">
          <div class="dish-detail-card__header">
            <h3>Câu chuyện nguồn gốc</h3>
          </div>
          <div class="dish-detail-expandable" data-expandable data-lines="8">
            <p data-lang-vi="<%= dish.originStoryVi || '-' %>" data-lang-en="<%= dish.originStoryEn || '-' %>"><%= dish.originStoryVi || '-' %></p>
            <button type="button" class="dish-detail-toggle" data-expand-toggle hidden>Xem thêm</button>
          </div>
        </article>
      </div>
    </section>

    <aside class="dish-detail-side">
      <section class="dish-detail-panel dish-detail-panel--compact">
        <h3>Xem trước người dùng</h3>
        <div class="dish-detail-preview dish-detail-preview--compact">
          <div class="dish-detail-preview__media">
            <% if (dish.imageUrl) { %>
              <img src="<%= dish.imageUrl %>" alt="<%= dish.nameVi %>" />
            <% } else { %>
              <div>Chưa có ảnh</div>
            <% } %>
          </div>
          <strong data-lang-vi="<%= dish.nameVi || '-' %>" data-lang-en="<%= dish.nameEn || '-' %>" title="<%= dish.nameVi || '-' %>"><%= dish.nameVi || '-' %></strong>
          <div class="dish-detail-preview__chips">
            <span><%= dish.provinceName34 || '-' %></span>
            <span><%= dish.regionCode || '-' %></span>
          </div>
          <div class="dish-detail-expandable" data-expandable data-lines="4">
            <p data-lang-vi="<%= dish.descriptionVi || '-' %>" data-lang-en="<%= dish.descriptionEn || '-' %>"><%= dish.descriptionVi || '-' %></p>
            <button type="button" class="dish-detail-toggle" data-expand-toggle hidden>Xem thêm</button>
          </div>
          <b data-lang-vi="<%= dish.priceRangeVi || '-' %>" data-lang-en="<%= dish.priceRangeEn || '-' %>"><%= dish.priceRangeVi || '-' %></b>
          <small data-lang-vi="<%= dish.categoryVi || '-' %>" data-lang-en="<%= dish.categoryEn || '-' %>" title="<%= dish.categoryVi || '-' %>"><%= dish.categoryVi || '-' %></small>
        </div>
      </section>
    </aside>
  </div>
</section>

<script src="/public/js/modules/dishes/detail.js"></script>
