<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> | <%= appName %></title>
  <link rel="stylesheet" href="/public/css/app.css" />
  <link rel="stylesheet" href="/public/css/components/notifications.css" />
  <% if (typeof pageStyles !== 'undefined') { pageStyles.forEach(function (href) { %>
    <link rel="stylesheet" href="<%= href %>" />
  <% }) } %>
</head>
<body class="admin-body">
  <div class="admin-overlay" data-sidebar-overlay></div>
  <div class="admin-shell">
    <aside class="admin-sidebar" id="admin-sidebar">
      <%- include('../partials/sidebar') %>
    </aside>
    <div class="admin-main">
      <header class="admin-topbar">
        <%- include('../partials/topbar') %>
      </header>
      <main class="admin-content">
        <%- body %>
      </main>
    </div>
  </div>
  <%- include('../partials/notifications') %>
  <script src="/public/js/core/notifications.js"></script>
  <script src="/public/js/core/app.js"></script>
  <% if (typeof pageScripts !== 'undefined') { pageScripts.forEach(function (src) { %>
    <script src="<%= src %>"></script>
  <% }) } %>
</body>
</html>
