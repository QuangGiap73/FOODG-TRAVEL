<button class="menu-toggle" type="button" aria-label="Mo menu" data-sidebar-toggle>
  <span></span>
  <span></span>
  <span></span>
</button>

<div class="topbar-heading">
  <div>
    <p class="eyebrow">Admin workspace</p>
    <h1><%= pageTitle %></h1>
  </div>
</div>

<div class="topbar-actions">
  <button class="icon-button" type="button" aria-label="Thong bao">
    <svg class="icon-svg" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M15 17h5l-1.4-1.4A2 2 0 0 1 18 14.2V11a6 6 0 1 0-12 0v3.2a2 2 0 0 1-.6 1.4L4 17h5"/>
      <path d="M10 21a2 2 0 0 0 4 0"/>
    </svg>
  </button>
  <div class="profile-chip">
    <div class="profile-chip__avatar">A</div>
    <div>
      <strong><%= user.displayName %></strong>
      <small><%= user.role %></small>
    </div>
  </div>
  <form method="post" action="/logout" class="topbar-logout-form">
    <button class="secondary-button topbar-logout-button" type="submit">
      Đăng xuất
    </button>
  </form>
</div>
